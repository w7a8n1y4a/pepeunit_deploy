PU_APP_PREFIX=/pepeunit
PU_API_V1_PREFIX=/api/v1

PU_WORKER_COUNT=2

PU_DOMAIN=192.168.0.22
PU_SECURE=False

PU_SAVE_REPO_PATH=repo_cache
PU_PROMETHEUS_MULTIPROC_DIR=./prometheus_metrics

PU_SECRET_KEY=<32-bit-key>
PU_ENCRYPT_KEY=<32-bit-key>

PU_SQLALCHEMY_DATABASE_URL=postgresql://myuser:mypassword@postgres:5432/pepeunit
PU_CLICKHOUSE_DATABASE_URL=clickhouse+native://admin:mypassword@clickhouse:9000/default
PU_REDIS_URL=redis://redis:6379/0

PU_NOTIFICATION_LOKI_URL=http://loki:3100

PU_MQTT_HOST=192.168.0.22
PU_MQTT_SECURE=False
PU_MQTT_PORT=1883
PU_MQTT_API_PORT=18083

PU_MQTT_USERNAME=admin
PU_MQTT_PASSWORD=password

PU_MQTT_REDIS_AUTH_URL=redis://redis:6379/0

PU_GRAFANA_ADMIN_USER=admin
PU_GRAFANA_ADMIN_PASSWORD=password
